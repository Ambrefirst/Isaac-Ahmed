# Configuration de construction pour la tour (servie par nginx).
# Chemins relatifs : le navigateur appelle nginx, qui relaie vers n8n en local.
# Les evenements rendez-vous passent par le workflow public minimal
# "Isaac - Visiteur (public)", pas par le routeur admin "isaac-rdv".
REACT_APP_N8N_CHAT_WEBHOOK=/webhook/isaac
REACT_APP_N8N_NOTIFICATION_WEBHOOK=/webhook/isaac-visitor
REACT_APP_N8N_APPOINTMENT_WEBHOOK=/webhook/isaac-visitor
REACT_APP_N8N_APPOINTMENTS_LOOKUP_WEBHOOK=/webhook/isaac-visitor
REACT_APP_N8N_APPOINTMENT_CANCEL_WEBHOOK=/webhook/isaac-visitor
