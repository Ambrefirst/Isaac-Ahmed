# Self-hosted n8n backend on tower (Tailscale IP)
# For local development against the tower's services:
REACT_APP_N8N_NOTIFICATION_WEBHOOK=http://ADRESSE-DE-LA-TOUR:5678/webhook/isaac
REACT_APP_N8N_CHAT_WEBHOOK=http://ADRESSE-DE-LA-TOUR:5678/webhook/isaac
REACT_APP_N8N_APPOINTMENT_WEBHOOK=http://ADRESSE-DE-LA-TOUR:5678/webhook/isaac-rdv
REACT_APP_N8N_APPOINTMENTS_LOOKUP_WEBHOOK=http://ADRESSE-DE-LA-TOUR:5678/webhook/isaac-rdv
REACT_APP_N8N_APPOINTMENT_CANCEL_WEBHOOK=http://ADRESSE-DE-LA-TOUR:5678/webhook/isaac-rdv

# Build served by the tower's nginx: use relative paths, and route the
# appointment events through the minimal public workflow "Isaac - Visiteur
# (public)" rather than the admin-capable "isaac-rdv" router. This is what the
# bundle currently deployed on the tower actually does (verified 21/09/2026).
# REACT_APP_N8N_NOTIFICATION_WEBHOOK=/webhook/isaac-visitor
# REACT_APP_N8N_CHAT_WEBHOOK=/webhook/isaac
# REACT_APP_N8N_APPOINTMENT_WEBHOOK=/webhook/isaac-visitor
# REACT_APP_N8N_APPOINTMENTS_LOOKUP_WEBHOOK=/webhook/isaac-visitor
# REACT_APP_N8N_APPOINTMENT_CANCEL_WEBHOOK=/webhook/isaac-visitor
