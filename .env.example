# Self-hosted n8n backend on tower (Tailscale IP)
# For local development against the tower's services:
REACT_APP_N8N_NOTIFICATION_WEBHOOK=http://100.71.79.97:5678/webhook/isaac
REACT_APP_N8N_CHAT_WEBHOOK=http://100.71.79.97:5678/webhook/isaac
REACT_APP_N8N_APPOINTMENT_WEBHOOK=http://100.71.79.97:5678/webhook/isaac-rdv
REACT_APP_N8N_APPOINTMENTS_LOOKUP_WEBHOOK=http://100.71.79.97:5678/webhook/isaac-rdv
REACT_APP_N8N_APPOINTMENT_CANCEL_WEBHOOK=http://100.71.79.97:5678/webhook/isaac-rdv

# If running on the tower itself (nginx), use relative paths instead:
# REACT_APP_N8N_NOTIFICATION_WEBHOOK=/webhook/isaac
# REACT_APP_N8N_CHAT_WEBHOOK=/webhook/isaac
# REACT_APP_N8N_APPOINTMENT_WEBHOOK=/webhook/isaac-rdv
# REACT_APP_N8N_APPOINTMENTS_LOOKUP_WEBHOOK=/webhook/isaac-rdv
# REACT_APP_N8N_APPOINTMENT_CANCEL_WEBHOOK=/webhook/isaac-rdv
