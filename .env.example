# URL du webhook n8n qui orchestre Outlook et Microsoft Teams
REACT_APP_N8N_NOTIFICATION_WEBHOOK=

# URL du webhook n8n qui traite les demandes de rendez-vous
REACT_APP_N8N_APPOINTMENT_WEBHOOK=

# URL du webhook n8n qui fait dialoguer Isaac avec le LLM (RAG + inférence)
REACT_APP_N8N_CHAT_WEBHOOK=

# URL du webhook n8n qui renvoie les rendez-vous d'un visiteur (recherche par email)
REACT_APP_N8N_APPOINTMENTS_LOOKUP_WEBHOOK=

# URL du webhook n8n qui traite l'annulation d'une demande de rendez-vous
REACT_APP_N8N_APPOINTMENT_CANCEL_WEBHOOK=
